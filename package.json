{
  "name": "desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "beta:batch": "node --env-file=.env scripts/create-beta-batch.mjs",
    "dev": "vite",
    "build": "vite build",
    "env:check:production": "node scripts/validate-production-env.mjs",
    "preview": "vite preview",
    "secrets:splits": "powershell -ExecutionPolicy Bypass -File scripts/set-split-confirmation-secrets.ps1",
    "test": "vitest run --environment jsdom --pool=vmThreads",
    "film:studio": "remotion studio src/remotion/index.ts",
    "film:render:vertical": "remotion render src/remotion/index.ts MeetYourManagerVertical out/meet-your-manager-vertical.mp4",
    "film:render:feed": "remotion render src/remotion/index.ts MeetYourManagerFeed out/meet-your-manager-feed.mp4",
    "film:render:landscape": "remotion render src/remotion/index.ts MeetYourManagerLandscape out/meet-your-manager-landscape.mp4"
  },
  "dependencies": {
    "@paddle/paddle-js": "^1.6.4",
    "@paddle/paddle-node-sdk": "^3.8.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@remotion/player": "4.0.520",
    "@remotion/transitions": "4.0.520",
    "@supabase/supabase-js": "^2.106.2",
    "border-beam": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.462.0",
    "posthog-js": "^1.399.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.520",
    "tailwind-merge": "^2.6.0",
    "thinking-orbs": "^0.1.1",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.520",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^20.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vitest": "^3.2.4"
  }
}
